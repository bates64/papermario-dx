BasedOnStyle: WebKit
IndentWidth: 4
UseTab: Never
ColumnLimit: 120

AllowShortIfStatementsOnASingleLine: false
AllowShortBlocksOnASingleLine: false
AllowShortEnumsOnASingleLine: false

BreakBeforeBraces: Custom
BraceWrapping:
    # Place opening brace on next line if the statement is multi-line
    # e.g.
    #  if (very
    #      long
    #      condition)
    #  {
    AfterControlStatement: MultiLine
    AfterFunction: false

AlignEscapedNewlines: DontAlign
SpaceAfterCStyleCast: true

IndentCaseLabels: true

BreakBeforeBinaryOperators: NonAssignment

ExperimentalAutoDetectBinPacking: false
BinPackParameters: BinPack
AlignAfterOpenBracket: BlockIndent

AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: false
AlignTrailingComments:
    Kind: Leave

WhitespaceSensitiveMacros: ["STRINGIFY"]

# Leave macro bodies as written, since their line breaks are often deliberate,
# like one entry per line in an X-macro list.
SkipMacroDefinitionBody: true

# N() names a map's symbols, so parse N(x) as the name x.
Macros:
    - N(name)=name

# Name the primitive typedefs, which clang-format otherwise can't tell from
# function names, as in s32 (*table)[2].
TypeNames: [s8, u8, s16, u16, s32, u32, s64, u64, f32, f64, b8, b16, b32]

# Our include order is WIP so disable it
SortIncludes: false
IncludeCategories:
    # common.h always comes first
    - Regex: '^"common\.h"$'
      Priority: 10
    # everything else
    - Regex: ".*"
      Priority: 1
      SortPriority: 0

AllowShortFunctionsOnASingleLine: None
