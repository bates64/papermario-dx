# Python packages the tools use directly. After editing, pin them and their
# dependencies into requirements.txt, then update the hash in
# tools/python-packages.nix from the mismatch a build reports:
#
#   nix run --inputs-from . nixpkgs#uv -- pip compile --universal --python-version 3.12 --no-annotate tools/requirements.in -o tools/requirements.txt
