{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Mod",
      "type": "shell",
      "command": "./build.sh",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "windows": {
        "command": "build.bat"
      }
    },
    {
      "label": "Build Mod (Nix)",
      "type": "shell",
      "command": "nix --extra-experimental-features \"flakes nix-command\" develop --profile .nix-profile --command ./build.sh",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "none"
      },
    },
    {
      "label": "Open Star Rod",
      "type": "shell",
      "command": "./star-rod.sh",
      "problemMatcher": [],
      "group": {
        "kind": "none"
      },
      "windows": {
        "command": "star-rod.bat"
      }
    },
    {
      "label": "Open Star Rod (Nix)",
      "type": "shell",
      "command": "nix --extra-experimental-features \"flakes nix-command\" develop --profile .nix-profile --command star-rod",
      "problemMatcher": [],
      "group": {
        "kind": "none"
      },
    }
  ]
}
